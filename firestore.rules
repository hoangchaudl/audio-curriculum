rules_version = '2';

// These rules replace the old "allow read, write: if true" (open to anyone
// on the internet who has the app URL). They now require a real signed-in
// Firebase Auth user, and further restrict writes by the caller's role
// (stored on their own /users/{uid} document) and identity (request.auth.uid).
//
// After editing this file, deploy it with the Firebase CLI:
//   firebase deploy --only firestore:rules
// (Requires an account with Editor/Owner access on the Firebase project.)
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Looks up the caller's own profile doc to read their role. Every
    // authenticated user has exactly one /users/{uid} doc, keyed by their
    // Firebase Auth uid (see store.tsx signup()).
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'admin';
    }

    function isEngineerOrAdmin() {
      return isSignedIn() && (callerRole() == 'audio_engineer' || callerRole() == 'admin');
    }

    // Restricted categories an admin has unlocked for the caller.
    function callerUnlocked() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('unlockedCategories', []);
    }

    // Curriculum documents (modules, moduleVideos) carry their category's
    // `restricted` flag (kept in sync by the admin client - see store.tsx).
    // Engineers/admins read everything; everyone else only unrestricted
    // content plus categories unlocked for them. Documents missing the flag
    // are treated as locked until an admin's client backfills it.
    function canReadCurriculum() {
      return isEngineerOrAdmin() || (isSignedIn() && (
               resource.data.get('restricted', true) == false ||
               resource.data.get('category', '') in callerUnlocked()
             ));
    }

    // A reviewer (trainer, engineer, key sound designer, producer) assigned
    // to this trainee in the assessment program.
    function isReviewerOf(traineeId) {
      return exists(/databases/$(database)/documents/enrollments/$(traineeId)) &&
             request.auth.uid in get(/databases/$(database)/documents/enrollments/$(traineeId)).data.get('reviewerUids', []);
    }

    // --- users ---
    // Profiles (name, email, role) are private: you read your own; admins
    // and audio engineers read the roster (dashboards, legacy grading);
    // reviewers read only the trainees assigned to them. A user may only
    // create/update their own document, and may not grant themselves a
    // different role than they signed up with - only an admin can.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isEngineerOrAdmin() || isReviewerOf(userId));

      // New accounts can only create themselves as a sound designer. The
      // single exception is the very first admin: allowed only when the
      // one-time /config/bootstrap claim is written in the same batch and
      // names this user (see store.tsx signup()).
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.id == userId
                    && !('unlockedCategories' in request.resource.data)
                    && (request.resource.data.role == 'sound_designer' ||
                        (request.resource.data.role == 'admin' &&
                         !exists(/databases/$(database)/documents/config/bootstrap) &&
                         getAfter(/databases/$(database)/documents/config/bootstrap).data.adminUid == request.auth.uid));

      // Users can edit their own profile (name, avatar, theme...) but not
      // their role or which restricted categories they're allowed into.
      allow update: if isSignedIn() && (
                      isAdmin() ||
                      (request.auth.uid == userId &&
                       request.resource.data.role == resource.data.role &&
                       request.resource.data.get('unlockedCategories', []) == resource.data.get('unlockedCategories', []))
                    );

      allow delete: if isAdmin();
    }

    // --- config/bootstrap (one-time first-admin claim) ---
    // Created exactly once: either by the first-ever signup together with
    // their own admin profile, or by an existing admin (older projects).
    // Never updated or deleted, so the first-admin path stays closed.
    match /config/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                    request.resource.data.adminUid == request.auth.uid && (
                      isAdmin() ||
                      (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
                    );
      allow update, delete: if false;
    }

    // --- categories ---
    // Everyone signed in can read the category list (sidebar sections);
    // only admins create, rename, reorder, lock, or delete them.
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- modules (curriculum content) ---
    // Readable per canReadCurriculum() above. Only admins can create,
    // edit, or delete modules (matches the Admin Dashboard's "Curriculum
    // Management" tab being admin-only in the UI).
    match /modules/{moduleId} {
      allow read: if canReadCurriculum();
      allow write: if isAdmin();
    }

    match /moduleVideos/{videoId} {
      allow read: if canReadCurriculum();
      allow write: if isAdmin();
    }

    // --- submissions (homework) ---
    // A sound designer can create/update only their own submissions.
    // Engineers/admins can read all submissions (needed to review/grade) and
    // may update the status field when grading, but can't rewrite someone
    // else's driveLink.
    match /submissions/{submissionId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn() && (
                      // owner can resubmit/update their own not-yet-graded work
                      (resource.data.userId == request.auth.uid && resource.data.status != 'graded') ||
                      // engineer/admin marking it graded
                      isEngineerOrAdmin()
                    );

      // Owner can pull back their own work before it's graded (lets them fix
      // a bad link and resend); admins can remove any submission.
      allow delete: if isAdmin() ||
                      (isSignedIn() && resource.data.userId == request.auth.uid && resource.data.status != 'graded');
    }

    // --- grades ---
    // Only engineers/admins can create grades, and only under their own
    // engineerId. Everyone signed in can read grades (designers need to see
    // their own feedback; dashboards need to compute averages).
    match /grades/{gradeId} {
      allow read: if isSignedIn();
      allow create: if isEngineerOrAdmin() && request.resource.data.engineerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- videoTasks (engineer training video assignments) ---
    // Admins assign/manage tasks; the assigned engineer can update their own
    // task's status/videoUrl.
    match /videoTasks/{taskId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() && (
                      isAdmin() ||
                      resource.data.engineerId == request.auth.uid
                    );
    }

    // --- videoProgress (a trainee finished a lesson / its video) ---
    // Written only by the trainee: a video watched to the end, or the
    // "Mark as done" toggle on program content pages (so they may also
    // delete - un-mark - their own record). Read: your own records, plus
    // admins/engineers for the progress dashboards.
    match /videoProgress/{progressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isEngineerOrAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ===== Assessment program (1-5 scale) =====
    // Legacy `submissions`/`grades` above are untouched; the new program
    // uses the collections below. See src/assessment/ for the data shapes.

    function enrollmentOf(traineeId) {
      return get(/databases/$(database)/documents/enrollments/$(traineeId)).data;
    }

    // True when the caller is the account an admin assigned to this slot
    // for this trainee (never inferred from names or emails).
    function isSlotHolder(traineeId, slot) {
      return isSignedIn() && enrollmentOf(traineeId).reviewers.get(slot, '') == request.auth.uid;
    }

    // Episode A: trainer only. Episode B: trainer + audio engineer.
    // Pod Trial: all four slots. Audio Description (DA): trainer, audio
    // engineer and producer.
    function allowedSlot(stage, slot) {
      return (stage == 'A' && slot == 'trainer') ||
             (stage == 'B' && slot in ['trainer', 'engineer']) ||
             (stage == 'DA' && slot in ['trainer', 'engineer', 'producer']) ||
             ((stage == 'P1' || stage == 'P2') && slot in ['trainer', 'engineer', 'keySoundDesigner', 'producer']);
    }

    function isStageReviewer(traineeId, stage) {
      return (allowedSlot(stage, 'trainer') && isSlotHolder(traineeId, 'trainer')) ||
             (allowedSlot(stage, 'engineer') && isSlotHolder(traineeId, 'engineer')) ||
             (allowedSlot(stage, 'keySoundDesigner') && isSlotHolder(traineeId, 'keySoundDesigner')) ||
             (allowedSlot(stage, 'producer') && isSlotHolder(traineeId, 'producer'));
    }

    // Score keys each slot may write. In the Pod Trial the producer scores
    // only SFX and Music; in Audio Description (DA) they score everything.
    function allowedKeys(stage, slot) {
      return stage == 'A' ? ['exercise']
           : ((stage == 'P1' || stage == 'P2') && slot == 'producer') ? ['sfx', 'music']
           : ['workflow', 'dialogue', 'sfx', 'music'];
    }

    function validScore(v) {
      return v is int && v >= 1 && v <= 5;
    }

    function scoresValid(scores, stage, slot) {
      return scores is map &&
             scores.keys().hasOnly(allowedKeys(stage, slot)) &&
             (!('exercise' in scores) || validScore(scores.exercise)) &&
             (!('workflow' in scores) || validScore(scores.workflow)) &&
             (!('dialogue' in scores) || validScore(scores.dialogue)) &&
             (!('sfx' in scores) || validScore(scores.sfx)) &&
             (!('music' in scores) || validScore(scores.music));
    }

    function publicationKey(stage) {
      return stage == 'A' ? 'episodeA' : (stage == 'B' ? 'episodeB' : (stage == 'DA' ? 'da' : 'pod'));
    }

    function isPublished(traineeId, stage) {
      return exists(/databases/$(database)/documents/publications/$(traineeId)) &&
             get(/databases/$(database)/documents/publications/$(traineeId)).data.get(publicationKey(stage), false) == true;
    }

    // Program structure and weights: readable by everyone signed in so
    // trainees see their rubric; only admins change them.
    match /assessmentConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Assignments and the week-by-week outline: everyone signed in reads
    // them (sidebar, milestones); only admins arrange or change them.
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /programOutline/{outlineId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // One per trainee (doc id = trainee uid). Admins enroll trainees and
    // assign reviewer accounts; trainees can't change their own.
    match /enrollments/{traineeId} {
      allow read: if isAdmin() ||
                  (isSignedIn() && (request.auth.uid == traineeId || request.auth.uid in resource.data.reviewerUids));
      allow write: if isAdmin();
    }

    // Append-only submission versions. A trainee creates their own (only
    // once enrolled); nobody - not even an admin - can edit or delete one.
    // The deterministic id makes a second write to the same version an
    // update, which is denied, so history can't be overwritten.
    match /assessmentSubmissions/{submissionId} {
      allow read: if isAdmin() ||
                  (isSignedIn() && (resource.data.traineeId == request.auth.uid ||
                                    isStageReviewer(resource.data.traineeId, resource.data.stage)));
      allow create: if isSignedIn() && request.resource.data.traineeId == request.auth.uid &&
                    exists(/databases/$(database)/documents/enrollments/$(request.auth.uid)) &&
                    request.resource.data.keys().hasOnly(['id', 'traineeId', 'stage', 'target', 'version', 'links', 'note', 'isComplete', 'submittedAt']) &&
                    request.resource.data.id == submissionId &&
                    request.resource.data.stage in ['A', 'B', 'P1', 'P2', 'DA'] &&
                    request.resource.data.version is int && request.resource.data.version >= 1 &&
                    submissionId == request.resource.data.traineeId + '__' + request.resource.data.stage + '__' +
                                    request.resource.data.target + '__v' + string(request.resource.data.version) &&
                    // Episode A: submitted against an Episode A assignment
                    // (or, for older data, directly against an exercise).
                    ((request.resource.data.stage == 'A' &&
                      (exists(/databases/$(database)/documents/exercises/$(request.resource.data.target)) ||
                       (exists(/databases/$(database)/documents/assignments/$(request.resource.data.target)) &&
                        get(/databases/$(database)/documents/assignments/$(request.resource.data.target)).data.stage == 'A'))) ||
                     (request.resource.data.stage != 'A' && request.resource.data.target == 'episode')) &&
                    (request.resource.data.stage != 'P2' || enrollmentOf(request.auth.uid).podEpisodesRequired == 2) &&
                    request.resource.data.links is list && request.resource.data.links.size() >= 1 && request.resource.data.links.size() <= 10 &&
                    request.resource.data.isComplete is bool;
      allow update, delete: if false;
    }

    // One review per (trainee, stage, target, reviewer slot). Only the
    // assigned slot holder writes it, only with that slot's criteria, only
    // against one of the trainee's own submissions for that target, and
    // only until the coordinator publishes the stage. Trainees read their
    // reviews once published; reviewers read only their own.
    match /reviews/{reviewId} {
      allow read: if isAdmin() ||
                  (isSignedIn() && resource.data.reviewerUid == request.auth.uid) ||
                  (isSignedIn() && resource.data.traineeId == request.auth.uid &&
                   isPublished(request.auth.uid, resource.data.stage));
      allow create, update: if isSignedIn() && reviewWriteOk(reviewId, request.resource.data);
      allow delete: if isAdmin();
    }

    function reviewWriteOk(reviewId, d) {
      return d.keys().hasOnly(['id', 'traineeId', 'stage', 'target', 'reviewerSlot', 'reviewerUid', 'submissionId', 'scores', 'feedback', 'status', 'updatedAt']) &&
             d.id == reviewId &&
             reviewId == d.traineeId + '__' + d.stage + '__' + d.target + '__' + d.reviewerSlot &&
             d.reviewerUid == request.auth.uid &&
             allowedSlot(d.stage, d.reviewerSlot) &&
             isSlotHolder(d.traineeId, d.reviewerSlot) &&
             d.status in ['draft', 'submitted'] &&
             scoresValid(d.scores, d.stage, d.reviewerSlot) &&
             (d.status == 'draft' || d.scores.keys().hasAll(allowedKeys(d.stage, d.reviewerSlot))) &&
             submissionMatches(d) &&
             !isPublished(d.traineeId, d.stage);
    }

    // Episode B/Pod reviews must point at a version the trainee marked
    // complete (the app picks the first complete one for Episode B).
    function submissionMatches(d) {
      let s = get(/databases/$(database)/documents/assessmentSubmissions/$(d.submissionId)).data;
      // Episode A reviews target an exercise (grading line); the submission
      // is for that exercise's assignment (or the exercise itself, legacy).
      return s.traineeId == d.traineeId && s.stage == d.stage &&
             (s.target == d.target ||
              (d.stage == 'A' && s.target == get(/databases/$(database)/documents/exercises/$(d.target)).data.get('assignmentId', ''))) &&
             (d.stage == 'A' || s.isComplete == true);
    }

    // Publication state per trainee (doc id = trainee uid). Only admins
    // (coordinators) publish; the trainee and their reviewers can read it.
    match /publications/{traineeId} {
      allow read: if isAdmin() ||
                  (isSignedIn() && (request.auth.uid == traineeId ||
                                    request.auth.uid in enrollmentOf(traineeId).reviewerUids));
      allow write: if isAdmin();
    }

    // End-of-probation (full-time offer) decisions: admins only - never
    // visible to the trainee or their reviewers.
    match /programOutcomes/{traineeId} {
      allow read, write: if isAdmin();
    }

    // Deny everything else by default (no catch-all open rule).
  }
}
